[Unit]
Description=letterslot (token download links + public upload drop box)
After=network-online.target
Wants=network-online.target

[Service]
User=letterslot
Group=letterslot
ExecStart=/usr/local/bin/letterslot \
    -public 0.0.0.0:8080 \
    -admin 0.0.0.0:80 \
    -files /srv/share/files \
    -incoming /srv/share/incoming \
    -state /var/lib/letterslot/state.json \
    -base-url https://share.example.com \
    -max-upload 2G \
    -min-free 4G \
    -upload-rate 20
Restart=on-failure
RestartSec=2

# State lives in /var/lib/letterslot (created by systemd, 0700 letterslot)
StateDirectory=letterslot
StateDirectoryMode=0700
UMask=0027

# Bind :80 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/share
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
